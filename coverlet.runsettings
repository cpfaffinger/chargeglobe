<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[ChargeGlobe.*]*</Include>
          <Exclude>[ChargeGlobe.*.Tests]*,[ChargeGlobe.IntegrationTests]*</Exclude>
          <!-- Auto-properties carry no logic; EF Core reads and writes entities through their backing fields. -->
          <SkipAutoProps>true</SkipAutoProps>
          <!-- Source-generator output (OpenAPI, Regex) is not our code. CompilerGeneratedAttribute must not
               be listed here: it marks the state machines of async methods and would hide their bodies. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <!-- EF Core migrations are generated by "dotnet ef migrations add"; Down() never runs in tests. -->
          <ExcludeByFile>**/obj/**/*.cs,**/Persistence/Migrations/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
