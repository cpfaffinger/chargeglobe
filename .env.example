# chargeglobe – infrastructure and bootstrap settings (complete list).
# Copy to .env and adjust. Everything functional (providers, intervals, rate limits, ...)
# is managed by the in-app config service, not here. See docs/02-architektur.md.

# Exposed HTTPS port of the stack (web app incl. /api). The only published port.
# HTTPS only, with a self-signed certificate created on first start (docs/adr/0009).
CHARGEGLOBE_PORT=5005
# Host address the port is published on: 0.0.0.0 (all interfaces, direct access) or 127.0.0.1
# when a reverse proxy on the same host (e.g. nginx with the public certificate) forwards to it.
CHARGEGLOBE_BIND_ADDRESS=0.0.0.0

# Database access (container-internal; the db port is not published).
POSTGRES_DB=chargeglobe
POSTGRES_USER=chargeglobe
# Required, no default. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Secret for signing access tokens (JWT, HS256). Required, no default, at least 32 characters;
# the stack does not start without it. Changing it invalidates all issued access tokens.
# Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=change-me

# Optional seed of the first admin user (role Admin, e-mail already confirmed), for automated
# installations. Only evaluated while no user exists at all; later changes have no effect. The
# password needs at least 10 characters (generate with: openssl rand -base64 18); a shorter one is
# logged as an error and no admin is created. Leave both empty (default) to create the first admin
# in the setup wizard at <PUBLIC_BASE_URL>/setup with the setup token from the API log:
#   docker compose logs api | grep "Setup required"
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Number of crawler / worker instances (Compose deploy.replicas).
CRAWLER_REPLICAS=1
WORKER_REPLICAS=1

# Optional compose services, comma separated. "routing" starts the routing engine Valhalla (POST /api/v1/routes);
# empty = without routing (the endpoint answers 503). Before enabling it on a host with little memory, put
# prebuilt tiles into ./data/routing (scripts/routing/build-tiles.sh), otherwise the first start builds them.
COMPOSE_PROFILES=

# Memory limit of the routing service when it serves prebuilt tiles. Building tiles for Austria needs more
# (about 3 GB); raise it or build elsewhere.
ROUTING_MEMORY_LIMIT=1g

# Memory of the database (Postgres parameters, override the tuning of the image on every start; docs/02, Betrieb).
# The defaults suit a host shared with other services. shared_buffers is reserved for Postgres alone; what does
# not fit is read through the page cache of the host, which the kernel can give to others.
DB_SHARED_BUFFERS=512MB
# What Postgres may assume of shared_buffers plus page cache, for its query plans (no allocation).
DB_EFFECTIVE_CACHE_SIZE=1536MB
# For index builds and vacuum (also the address import); per running operation.
DB_MAINTENANCE_WORK_MEM=256MB
# Per sort or hash step of a query before it spills to disk.
DB_WORK_MEM=16MB
# Memory limit of the db container (Compose mem_limit); above shared_buffers plus connections, the page cache of the
# container is kept below it.
DB_MEMORY_LIMIT=2g

# Minimum log level: Trace | Debug | Information | Warning | Error | Critical
LOG_LEVEL=Information

# Public base URL (https://, no trailing slash), used for links in API responses and e-mails
# (/confirm-email, /reset-password). Its host name is
# also put into the self-signed certificate (delete ./data/tls to recreate it).
PUBLIC_BASE_URL=https://localhost:5005
