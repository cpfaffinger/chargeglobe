# chargeglobe – infrastructure and bootstrap settings (complete list).
# Copy to .env and adjust. Everything functional (providers, intervals, rate limits, ...)
# is managed by the in-app config service, not here. See docs/02-architektur.md.

# Exposed HTTP port of the stack (web app incl. /api). The only published port.
CHARGEGLOBE_PORT=5005

# Database access (container-internal; the db port is not published).
POSTGRES_DB=chargeglobe
POSTGRES_USER=chargeglobe
# Required, no default. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Secret for signing access tokens (JWT). Required once identity is enabled, no default.
# Generate with: openssl rand -hex 32
JWT_SIGNING_KEY=change-me

# Seed of the first admin user; only evaluated on first start. No default.
ADMIN_EMAIL=admin@example.org
ADMIN_INITIAL_PASSWORD=change-me

# Number of crawler / worker instances (Compose deploy.replicas).
CRAWLER_REPLICAS=1
WORKER_REPLICAS=1

# Minimum log level: Trace | Debug | Information | Warning | Error | Critical
LOG_LEVEL=Information

# Public base URL, used for links in API responses and e-mails.
PUBLIC_BASE_URL=http://localhost:5005
