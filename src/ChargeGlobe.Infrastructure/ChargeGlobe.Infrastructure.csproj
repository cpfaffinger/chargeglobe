<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <!-- Transitive via MailKit/MimeKit; pinned to the release that fixes CVE-2026-84008 and CVE-2026-70162 (NU1902/NU1903 fail the build). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Region polygons from OpenStreetMap (ODbL), loaded by RegionSeeder; rebuilt by scripts/regions/build-regions-at.sh. -->
    <EmbeddedResource Include="Persistence\Seed\regions-at.geojson" LogicalName="ChargeGlobe.Infrastructure.Persistence.Seed.regions-at.geojson" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChargeGlobe.Application\ChargeGlobe.Application.csproj" />
  </ItemGroup>

</Project>
