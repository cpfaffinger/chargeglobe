<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChargeGlobe.Providers.Abstractions\ChargeGlobe.Providers.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mapping tables as JSON (docs/04, rule 3), so that non-developers can extend them. -->
    <EmbeddedResource Include="Mapping\*.json" LogicalName="ocm-%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
